        <textarea class="textarea" id="derivedPromptBox" readonly style="min-height:230px"></textarea>
        <p class="notice charcount" id="cc-derivedPromptBox"></p>
        </div>
        <div class="prompt-pane hidden" id="pane-group">
        <div id="groupSection" class="hidden" style="margin-top:14px">
          <div class="section-title"><h2 id="groupPromptTitle" style="font-size:15px">集合写真 指示文</h2><button class="btn primary" id="copyGroupBtn">📋 コピー</button></div>
          <p class="notice pane-desc" id="desc-group"></p>
          <textarea class="textarea" id="groupPromptBox" readonly style="min-height:230px"></textarea>
          <p class="notice charcount" id="cc-groupPromptBox"></p>
        </div>
        </div>
      </div>
    </section>

    <section id="tab-history" class="panel hidden" style="margin-top:14px">
      <div class="subcard" style="margin-bottom:12px"><h3 id="restoreTitle">復元コードから読み込む</h3>
        <textarea class="textarea" id="restoreCodeInput" style="min-height:70px" placeholder="基準カードの画像指示文（日本語）を丸ごと貼り付けると人物を読み取ります"></textarea>
        <div class="toolbar" style="margin-top:6px"><button class="btn primary" id="restoreCodeBtn">読み込む</button><span class="notice" id="restoreNote">プロンプト全文のままでもコード単体でも読み込めます</span></div>
      </div>
      <div class="section-title"><h2>保存結果</h2><button class="btn red" id="clearHistoryBtn">履歴クリア</button></div>
      <div class="history" id="historyList"></div>
    </section>

    <section id="tab-settings" class="panel hidden" style="margin-top:14px">
      <div class="section-title"><h2>条件固定ランダム</h2><span class="pill">空欄はランダム</span></div>
      <div class="form" id="fixedForm"></div>
      <p class="notice" style="margin-top:12px">固定条件を選んだ状態で「SLOT START」を押すと、指定した人物・服装項目を優先してランダム生成します。背景・光・画質・出力タイプ・出力枚数は上部の初期設定または結果画面の選択欄で指定します。</p>
    </section>

