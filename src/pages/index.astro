background:#f7c948;color:#160f00}.hidden{display:none!important}.subcard{border:1px solid #ffffff18;background:#ffffff07;border-radius:18px;padding:14px;grid-column:1/-1}.subcard h3{margin:0 0 10px;font-size:15px;color:#e8eef9}.profile-section{border:1px solid #ffffff18;background:#ffffff08;border-radius:16px;padding:12px;margin:0 0 12px}.profile-section h3{margin:0 0 10px;font-size:15px;color:#f7c948}.badge-row{display:flex;gap:8px;flex-wrap:wrap}.mini-badge{display:inline-flex;border:1px solid #ffffff22;background:#ffffff10;border-radius:999px;padding:5px 9px;font-weight:850;font-size:12px;color:#dbeafe}.inner-badge{display:inline-block;border-radius:999px;padding:2px 8px;font-weight:900;font-size:10.5px;vertical-align:middle;margin-left:2px}.ib-rare{border:1px solid #f7c948aa;background:#f7c94822;color:#ffe9a3}.ib-gap{border:1px solid #67e8f9aa;background:#67e8f91e;color:#a7f3ff}
